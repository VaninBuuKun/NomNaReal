# ============================================
# NomNa Production Environment Variables Template
# ============================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# WARNING: NEVER commit .env to Git repository!

# --- PostgreSQL Database ---
POSTGRES_DB=NomNa
POSTGRES_USER=nomna_user
POSTGRES_PASSWORD=replace_with_a_secure_password_here

# --- NomNa Backend Application ---
ASPNETCORE_ENVIRONMENT=Production
# Database connection string constructed from above variables
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
# Redis connection string (points to the internal redis service)
ConnectionStrings__Redis=redis:6379

# --- JWT Authentication ---
# Generate a strong 64-char key: openssl rand -base64 48
Jwt__Secret=replace_with_a_very_long_secure_jwt_secret_key_at_least_64_chars!
Jwt__Issuer=NomNa
Jwt__Audience=NomNaClient
Jwt__ExpirationMinutes=60

# --- CORS Allowed Origins ---
# Allow requests from your production domain (and local testing if needed)
Cors__AllowedOrigins__0=http://localhost:8080
Cors__AllowedOrigins__1=https://your-domain.com

# --- AWS S3 / Cloudflare R2 (Object Storage for Attachments & Media) ---
AwsS3__BucketName=nomnarealtime
AwsS3__Region=ap-southeast-1
AwsS3__AccessKey=your_aws_or_r2_access_key
AwsS3__SecretKey=your_aws_or_r2_secret_key

# --- Google OAuth (Optional) ---
Authentication__Google__ClientId=your_google_client_id.apps.googleusercontent.com

# --- SMTP Email Service (Optional, for notifications/invites) ---
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=your-email@gmail.com
Email__SmtpPass=your-app-password
Email__SenderEmail=no-reply@nomna.app
Email__SenderName=NomNa Chat

# --- Frontend Build Arguments ---
VITE_API_URL=/api
VITE_DEFAULT_AVATAR=/default-avatar.png
VITE_GOOGLE_CLIENT_ID=

# --- Domain & SSL (Used when deploying with Nginx & Certbot on VPS) ---
DOMAIN=your-domain.com
CERTBOT_EMAIL=your-email@example.com
