<?xml version="1.0" encoding="utf-8"?>
<!-- NomNa Chat Application - Domain Database Architecture Schema Export -->
<DatabaseSchema name="NomNa" version="3.0" engine="PostgreSQL" orm="EF Core 9">
  
  <Tables>
    <!-- 1. USERS & IDENTITY -->
    <Table name="users" entity="User" description="Application users extending ASP.NET Core Identity">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="UserName" type="varchar(256)" isNullable="false" isUnique="true" />
      <Column name="NormalizedUserName" type="varchar(256)" isNullable="false" />
      <Column name="Email" type="varchar(256)" isNullable="false" isUnique="true" />
      <Column name="NormalizedEmail" type="varchar(256)" isNullable="false" />
      <Column name="DisplayName" type="varchar(100)" isNullable="false" />
      <Column name="AvatarUrl" type="varchar(500)" isNullable="true" />
      <Column name="Bio" type="varchar(250)" isNullable="true" />
      <Column name="Status" type="integer" isNullable="false" default="0" description="0=Online, 1=Away, 2=DoNotDisturb, 3=Offline" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
    </Table>

    <!-- 2. REFRESH TOKENS -->
    <Table name="refresh_tokens" entity="RefreshToken" description="JWT Refresh tokens with rotation">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="UserId" type="uuid" isNullable="false" />
      <Column name="TokenHash" type="text" isNullable="false" />
      <Column name="ExpiresAt" type="timestamp with time zone" isNullable="false" />
      <Column name="RevokedAt" type="timestamp with time zone" isNullable="true" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <ForeignKey name="FK_refresh_tokens_users" column="UserId" referencesTable="users" referencesColumn="Id" onDelete="Cascade" />
    </Table>

    <!-- 3. CLASSROOMS -->
    <Table name="classrooms" entity="Classroom" description="Educational classrooms / server workspaces">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="Name" type="varchar(100)" isNullable="false" />
      <Column name="Description" type="varchar(1000)" isNullable="true" />
      <Column name="IconUrl" type="varchar(500)" isNullable="true" />
      <Column name="InviteCode" type="varchar(16)" isNullable="false" isUnique="true" />
      <Column name="OwnerId" type="uuid" isNullable="false" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_classrooms_users_OwnerId" column="OwnerId" referencesTable="users" referencesColumn="Id" onDelete="Restrict" />
    </Table>

    <!-- 4. CLASSROOM MEMBERS -->
    <Table name="classroom_members" entity="ClassroomMember" description="Membership and roles in classrooms">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ClassroomId" type="uuid" isNullable="false" />
      <Column name="UserId" type="uuid" isNullable="false" />
      <Column name="Role" type="integer" isNullable="false" default="0" description="0=Student/Member, 1=Teacher/Admin, 2=Owner" />
      <Column name="JoinedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_classroom_members_classrooms" column="ClassroomId" referencesTable="classrooms" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_classroom_members_users" column="UserId" referencesTable="users" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_classroom_members_unique" columns="ClassroomId, UserId" isUnique="true" />
    </Table>

    <!-- 5. CHANNELS -->
    <Table name="channels" entity="Channel" description="Text, announcement, and DM channels">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ClassroomId" type="uuid" isNullable="true" description="Nullable for direct message conversations" />
      <Column name="Name" type="varchar(50)" isNullable="true" />
      <Column name="Type" type="integer" isNullable="false" default="0" description="0=Text, 1=Voice, 2=DirectMessage, 3=Announcement" />
      <Column name="CreatedById" type="uuid" isNullable="false" />
      <Column name="LastMessageContent" type="varchar(500)" isNullable="true" />
      <Column name="LastMessageAt" type="timestamp with time zone" isNullable="true" />
      <Column name="LastMessageSenderId" type="uuid" isNullable="true" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_channels_classrooms" column="ClassroomId" referencesTable="classrooms" referencesColumn="Id" onDelete="Cascade" />
    </Table>

    <!-- 6. CHANNEL MEMBERS -->
    <Table name="channel_members" entity="ChannelMember" description="Explicit membership in channels">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ChannelId" type="uuid" isNullable="false" />
      <Column name="UserId" type="uuid" isNullable="false" />
      <Column name="LastReadAt" type="timestamp with time zone" isNullable="true" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_channel_members_channels" column="ChannelId" referencesTable="channels" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_channel_members_users" column="UserId" referencesTable="users" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_channel_members_unique" columns="ChannelId, UserId" isUnique="true" />
    </Table>

    <!-- 7. MESSAGES -->
    <Table name="messages" entity="Message" description="Real-time messages with thread, edits, and json attachments">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ChannelId" type="uuid" isNullable="false" />
      <Column name="SenderId" type="uuid" isNullable="false" />
      <Column name="Content" type="varchar(4000)" isNullable="false" />
      <Column name="ThreadId" type="uuid" isNullable="true" description="Points to root message if reply" />
      <Column name="ReplyCount" type="integer" isNullable="false" default="0" />
      <Column name="IsEdited" type="boolean" isNullable="false" default="false" />
      <Column name="EditedAt" type="timestamp with time zone" isNullable="true" />
      <Column name="DeletedAt" type="timestamp with time zone" isNullable="true" />
      <Column name="Attachments" type="jsonb" isNullable="true" description="Owned list of MessageAttachment (Url, FileName, FileSize, ContentType)" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_messages_channels" column="ChannelId" referencesTable="channels" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_messages_users_SenderId" column="SenderId" referencesTable="users" referencesColumn="Id" onDelete="Restrict" />
      <ForeignKey name="FK_messages_messages_ThreadId" column="ThreadId" referencesTable="messages" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_messages_channel_created" columns="ChannelId, CreatedAt" />
      <Index name="idx_messages_thread_created" columns="ThreadId, CreatedAt" />
      <Index name="idx_messages_channel_root_created" columns="ChannelId, CreatedAt" filter="DeletedAt IS NULL AND ThreadId IS NULL" />
    </Table>

    <!-- 8. MESSAGE REACTIONS -->
    <Table name="message_reactions" entity="MessageReaction" description="Emoji reactions to messages">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="MessageId" type="uuid" isNullable="false" />
      <Column name="UserId" type="uuid" isNullable="false" />
      <Column name="Emoji" type="varchar(32)" isNullable="false" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_message_reactions_messages" column="MessageId" referencesTable="messages" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_message_reactions_users" column="UserId" referencesTable="users" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_message_reactions_unique" columns="MessageId, UserId, Emoji" isUnique="true" />
    </Table>

    <!-- 9. CHANNEL PINNED MESSAGES -->
    <Table name="channel_pinned_messages" entity="ChannelPinnedMessage" description="Pinned messages in channels">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ChannelId" type="uuid" isNullable="false" />
      <Column name="MessageId" type="uuid" isNullable="false" />
      <Column name="PinnedById" type="uuid" isNullable="false" />
      <Column name="PinnedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_channel_pinned_messages_channels" column="ChannelId" referencesTable="channels" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_channel_pinned_messages_messages" column="MessageId" referencesTable="messages" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_channel_pinned_messages_users" column="PinnedById" referencesTable="users" referencesColumn="Id" onDelete="Restrict" />
      <Index name="idx_channel_pinned_unique" columns="ChannelId, MessageId" isUnique="true" />
    </Table>

    <!-- 10. NOTIFICATIONS -->
    <Table name="notifications" entity="Notification" description="User notifications for mentions, replies, etc.">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="UserId" type="uuid" isNullable="false" />
      <Column name="Type" type="integer" isNullable="false" description="0=Mention, 1=Reply, 2=Reaction, 3=Assignment, 4=System" />
      <Column name="Title" type="varchar(200)" isNullable="false" />
      <Column name="Body" type="varchar(1000)" isNullable="false" />
      <Column name="ActionUrl" type="varchar(500)" isNullable="true" />
      <Column name="IsRead" type="boolean" isNullable="false" default="false" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_notifications_users" column="UserId" referencesTable="users" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_notifications_user_read" columns="UserId, IsRead" />
    </Table>

    <!-- 11. TASK ITEMS (KANBAN / TO-DO) -->
    <Table name="task_items" entity="TaskItem" description="Tasks with Kanban status and priority">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ClassroomId" type="uuid" isNullable="false" />
      <Column name="ChannelId" type="uuid" isNullable="true" />
      <Column name="CreatedById" type="uuid" isNullable="false" />
      <Column name="AssigneeId" type="uuid" isNullable="true" />
      <Column name="Title" type="varchar(300)" isNullable="false" />
      <Column name="Description" type="varchar(4000)" isNullable="true" />
      <Column name="Status" type="integer" isNullable="false" default="0" description="0=Todo, 1=InProgress, 2=Review, 3=Done" />
      <Column name="Priority" type="integer" isNullable="false" default="1" description="0=Low, 1=Medium, 2=High, 3=Urgent" />
      <Column name="DueDate" type="timestamp with time zone" isNullable="true" />
      <Column name="CompletedAt" type="timestamp with time zone" isNullable="true" />
      <Column name="CompletionNote" type="varchar(2000)" isNullable="true" />
      <Column name="SourceMessageId" type="uuid" isNullable="true" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_task_items_classrooms" column="ClassroomId" referencesTable="classrooms" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_task_items_channels" column="ChannelId" referencesTable="channels" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_task_items_users_CreatedById" column="CreatedById" referencesTable="users" referencesColumn="Id" onDelete="Restrict" />
      <ForeignKey name="FK_task_items_users_AssigneeId" column="AssigneeId" referencesTable="users" referencesColumn="Id" onDelete="SetNull" />
      <ForeignKey name="FK_task_items_messages" column="SourceMessageId" referencesTable="messages" referencesColumn="Id" onDelete="SetNull" />
    </Table>

    <!-- 12. CLASS SCHEDULES (TIMETABLE) -->
    <Table name="class_schedules" entity="ClassScheduleItem" description="Classroom weekly class sessions and timetables">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ClassroomId" type="uuid" isNullable="false" />
      <Column name="ChannelId" type="uuid" isNullable="true" />
      <Column name="Title" type="varchar(200)" isNullable="false" />
      <Column name="Subject" type="varchar(100)" isNullable="true" />
      <Column name="InstructorName" type="varchar(100)" isNullable="true" />
      <Column name="InstructorRole" type="varchar(100)" isNullable="true" />
      <Column name="DayOfWeek" type="integer" isNullable="false" description="1=Monday, 2=Tuesday, ..., 7=Sunday" />
      <Column name="StartTime" type="time without time zone" isNullable="false" />
      <Column name="EndTime" type="time without time zone" isNullable="false" />
      <Column name="Location" type="varchar(200)" isNullable="true" />
      <Column name="Description" type="varchar(2000)" isNullable="true" />
      <Column name="CreatedById" type="uuid" isNullable="false" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_class_schedules_classrooms" column="ClassroomId" referencesTable="classrooms" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_class_schedules_channels" column="ChannelId" referencesTable="channels" referencesColumn="Id" onDelete="SetNull" />
      <ForeignKey name="FK_class_schedules_users" column="CreatedById" referencesTable="users" referencesColumn="Id" onDelete="Restrict" />
      <Index name="idx_class_schedules_classroom_day" columns="ClassroomId, DayOfWeek" />
    </Table>

    <!-- 13. STUDY REMINDERS -->
    <Table name="study_reminders" entity="StudyReminder" description="Streamlined user reminders for chat &amp; schedule">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="UserId" type="uuid" isNullable="false" />
      <Column name="Title" type="varchar(300)" isNullable="false" />
      <Column name="RemindAt" type="timestamp with time zone" isNullable="false" />
      <Column name="IsFired" type="boolean" isNullable="false" default="false" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_study_reminders_users" column="UserId" referencesTable="users" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_study_reminders_user_fired" columns="UserId, IsFired" />
      <Index name="idx_study_reminders_remind_at" columns="RemindAt" />
    </Table>

    <!-- 14. CLASSROOM TOPICS (CURRICULUM CHAPTERS) -->
    <Table name="classroom_topics" entity="ClassroomTopic" description="Curriculum chapters/topics grouping classroom items">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ClassroomId" type="uuid" isNullable="false" />
      <Column name="Title" type="varchar(300)" isNullable="false" />
      <Column name="Description" type="varchar(2000)" isNullable="true" />
      <Column name="OrderIndex" type="integer" isNullable="false" default="0" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_classroom_topics_classrooms" column="ClassroomId" referencesTable="classrooms" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_classroom_topics_classroom_order" columns="ClassroomId, OrderIndex" />
    </Table>

    <!-- 15. CLASSROOM ITEMS (LESSONS & ASSIGNMENTS) -->
    <Table name="classroom_items" entity="ClassroomItem" description="Curriculum items: Assignments, Videos, Documents, Links">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="TopicId" type="uuid" isNullable="false" />
      <Column name="ClassroomId" type="uuid" isNullable="false" />
      <Column name="Title" type="varchar(300)" isNullable="false" />
      <Column name="Description" type="varchar(5000)" isNullable="true" />
      <Column name="Type" type="integer" isNullable="false" default="0" description="0=Assignment, 1=Video, 2=Document, 3=Url" />
      <Column name="OrderIndex" type="integer" isNullable="false" default="0" />
      <Column name="ResourceUrl" type="varchar(2000)" isNullable="true" description="Video, PDF document, or External URL link" />
      <Column name="ResourceName" type="varchar(500)" isNullable="true" />
      <Column name="DueDate" type="timestamp with time zone" isNullable="true" description="Applicable for Assignment type" />
      <Column name="MaxFileSizeMb" type="integer" isNullable="false" default="25" />
      <Column name="MaxFiles" type="integer" isNullable="false" default="1" />
      <Column name="AllowedExtensions" type="varchar(200)" isNullable="false" default="'.zip,.pdf,.docx'" />
      <Column name="MaxScore" type="numeric(5,2)" isNullable="false" default="10.00" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_classroom_items_topics" column="TopicId" referencesTable="classroom_topics" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_classroom_items_classrooms" column="ClassroomId" referencesTable="classrooms" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_classroom_items_topic_order" columns="TopicId, OrderIndex" />
      <Index name="idx_classroom_items_classroom" columns="ClassroomId" />
    </Table>

    <!-- 16. CLASSROOM ITEM SUBMISSIONS -->
    <Table name="classroom_item_submissions" entity="ClassroomItemSubmission" description="Student submissions and teacher grading for assignments">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="ClassroomItemId" type="uuid" isNullable="false" />
      <Column name="StudentId" type="uuid" isNullable="false" />
      <Column name="SubmittedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="IsCompleted" type="boolean" isNullable="false" default="true" />
      <Column name="Score" type="numeric(5,2)" isNullable="true" />
      <Column name="Feedback" type="varchar(4000)" isNullable="true" />
      <Column name="GradedById" type="uuid" isNullable="true" />
      <Column name="GradedAt" type="timestamp with time zone" isNullable="true" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_classroom_item_submissions_items" column="ClassroomItemId" referencesTable="classroom_items" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_classroom_item_submissions_students" column="StudentId" referencesTable="users" referencesColumn="Id" onDelete="Cascade" />
      <ForeignKey name="FK_classroom_item_submissions_graders" column="GradedById" referencesTable="users" referencesColumn="Id" onDelete="SetNull" />
      <Index name="idx_classroom_item_submissions_unique_student" columns="ClassroomItemId, StudentId" isUnique="true" />
    </Table>

    <!-- 17. SUBMISSION ATTACHMENT ITEMS -->
    <Table name="submission_attachment_items" entity="SubmissionAttachmentItem" description="Uploaded files attached to an assignment submission">
      <Column name="Id" type="uuid" isPrimaryKey="true" isNullable="false" />
      <Column name="SubmissionId" type="uuid" isNullable="false" />
      <Column name="Url" type="varchar(2000)" isNullable="false" />
      <Column name="FileName" type="varchar(500)" isNullable="false" />
      <Column name="FileSize" type="bigint" isNullable="false" default="0" />
      <Column name="ContentType" type="varchar(150)" isNullable="true" />
      <Column name="CreatedAt" type="timestamp with time zone" isNullable="false" />
      <Column name="UpdatedAt" type="timestamp with time zone" isNullable="true" />
      <ForeignKey name="FK_submission_attachment_items_submissions" column="SubmissionId" referencesTable="classroom_item_submissions" referencesColumn="Id" onDelete="Cascade" />
      <Index name="idx_submission_attachment_submission" columns="SubmissionId" />
    </Table>
  </Tables>

  <Relationships>
    <Relationship fromTable="classrooms" fromColumn="OwnerId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="classroom_members" fromColumn="ClassroomId" toTable="classrooms" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="classroom_members" fromColumn="UserId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="channels" fromColumn="ClassroomId" toTable="classrooms" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="channel_members" fromColumn="ChannelId" toTable="channels" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="channel_members" fromColumn="UserId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="messages" fromColumn="ChannelId" toTable="channels" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="messages" fromColumn="SenderId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="messages" fromColumn="ThreadId" toTable="messages" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="message_reactions" fromColumn="MessageId" toTable="messages" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="message_reactions" fromColumn="UserId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="channel_pinned_messages" fromColumn="ChannelId" toTable="channels" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="channel_pinned_messages" fromColumn="MessageId" toTable="messages" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="notifications" fromColumn="UserId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="task_items" fromColumn="ClassroomId" toTable="classrooms" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="class_schedules" fromColumn="ClassroomId" toTable="classrooms" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="study_reminders" fromColumn="UserId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="refresh_tokens" fromColumn="UserId" toTable="users" toColumn="Id" type="ManyToOne" />
    
    <!-- Curriculum Relationships -->
    <Relationship fromTable="classroom_topics" fromColumn="ClassroomId" toTable="classrooms" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="classroom_items" fromColumn="TopicId" toTable="classroom_topics" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="classroom_items" fromColumn="ClassroomId" toTable="classrooms" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="classroom_item_submissions" fromColumn="ClassroomItemId" toTable="classroom_items" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="classroom_item_submissions" fromColumn="StudentId" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="classroom_item_submissions" fromColumn="GradedById" toTable="users" toColumn="Id" type="ManyToOne" />
    <Relationship fromTable="submission_attachment_items" fromColumn="SubmissionId" toTable="classroom_item_submissions" toColumn="Id" type="ManyToOne" />
  </Relationships>
</DatabaseSchema>
