// NomNa Chat & LMS Application - DBML Schema Definition
// Import or paste directly into https://dbdiagram.io or https://drawsql.app to visualize the entire schema

Table users {
  id uuid [pk]
  user_name varchar(256) [not null, unique]
  normalized_user_name varchar(256) [not null]
  email varchar(256) [not null, unique]
  normalized_email varchar(256) [not null]
  display_name varchar(100) [not null]
  avatar_url varchar(500)
  bio varchar(250)
  status int [not null, default: 0, note: "0=Online, 1=Away, 2=DoNotDisturb, 3=Offline"]
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash text [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]
}

Table classrooms {
  id uuid [pk]
  name varchar(100) [not null]
  description varchar(1000)
  icon_url varchar(500)
  invite_code varchar(16) [not null, unique]
  owner_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table classroom_members {
  id uuid [pk]
  classroom_id uuid [not null]
  user_id uuid [not null]
  role int [not null, default: 0, note: "0=Student, 1=Teacher, 2=Owner"]
  joined_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (classroom_id, user_id) [unique]
  }
}

Table channels {
  id uuid [pk]
  classroom_id uuid [note: "null for Direct Messages"]
  name varchar(50)
  type int [not null, default: 0, note: "0=Text, 1=Voice, 2=DirectMessage, 3=Announcement"]
  created_by_id uuid [not null]
  last_message_content varchar(500)
  last_message_at timestamptz
  last_message_sender_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table channel_members {
  id uuid [pk]
  channel_id uuid [not null]
  user_id uuid [not null]
  last_read_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (channel_id, user_id) [unique]
  }
}

Table messages {
  id uuid [pk]
  channel_id uuid [not null]
  sender_id uuid [not null]
  content varchar(4000) [not null]
  thread_id uuid [note: "points to root message if reply"]
  reply_count int [not null, default: 0]
  is_edited bool [not null, default: false]
  edited_at timestamptz
  deleted_at timestamptz
  attachments jsonb [note: "list of message attachments {url, fileName, fileSize, contentType}"]
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (channel_id, created_at)
    (thread_id, created_at)
  }
}

Table message_reactions {
  id uuid [pk]
  message_id uuid [not null]
  user_id uuid [not null]
  emoji varchar(32) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (message_id, user_id, emoji) [unique]
  }
}

Table channel_pinned_messages {
  id uuid [pk]
  channel_id uuid [not null]
  message_id uuid [not null]
  pinned_by_id uuid [not null]
  pinned_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (channel_id, message_id) [unique]
  }
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  type int [not null, note: "0=Mention, 1=Reply, 2=Reaction, 3=Assignment, 4=System"]
  title varchar(200) [not null]
  body varchar(1000) [not null]
  action_url varchar(500)
  is_read bool [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table task_items {
  id uuid [pk]
  classroom_id uuid [not null]
  channel_id uuid
  created_by_id uuid [not null]
  assignee_id uuid
  title varchar(300) [not null]
  description varchar(4000)
  status int [not null, default: 0, note: "0=Todo, 1=InProgress, 2=Review, 3=Done"]
  priority int [not null, default: 1, note: "0=Low, 1=Medium, 2=High, 3=Urgent"]
  due_date timestamptz
  completed_at timestamptz
  completion_note varchar(2000)
  source_message_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table class_schedules {
  id uuid [pk]
  classroom_id uuid [not null]
  channel_id uuid
  title varchar(200) [not null]
  subject varchar(100)
  instructor_name varchar(100)
  instructor_role varchar(100)
  day_of_week int [not null, note: "1=Monday..7=Sunday"]
  start_time time [not null]
  end_time time [not null]
  location varchar(200)
  description varchar(2000)
  created_by_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table study_reminders {
  id uuid [pk]
  user_id uuid [not null]
  title varchar(300) [not null]
  remind_at timestamptz [not null]
  is_fired bool [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table classroom_topics {
  id uuid [pk]
  classroom_id uuid [not null]
  title varchar(300) [not null]
  description varchar(2000)
  order_index int [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (classroom_id, order_index)
  }
}

Table classroom_items {
  id uuid [pk]
  topic_id uuid [not null]
  classroom_id uuid [not null]
  title varchar(300) [not null]
  description varchar(5000)
  type int [not null, default: 0, note: "0=Assignment, 1=Video, 2=Document, 3=Url"]
  order_index int [not null, default: 0]
  resource_url varchar(2000)
  resource_name varchar(500)
  due_date timestamptz
  max_file_size_mb int [not null, default: 25]
  max_files int [not null, default: 1]
  allowed_extensions varchar(200) [not null, default: "'.zip,.pdf,.docx'"]
  max_score decimal(5,2) [not null, default: 10.00]
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (topic_id, order_index)
    classroom_id
  }
}

Table classroom_item_submissions {
  id uuid [pk]
  classroom_item_id uuid [not null]
  student_id uuid [not null]
  submitted_at timestamptz [not null]
  is_completed bool [not null, default: true]
  score decimal(5,2)
  feedback varchar(4000)
  graded_by_id uuid
  graded_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    (classroom_item_id, student_id) [unique]
  }
}

Table submission_attachment_items {
  id uuid [pk]
  submission_id uuid [not null]
  url varchar(2000) [not null]
  file_name varchar(500) [not null]
  file_size bigint [not null, default: 0]
  content_type varchar(150)
  created_at timestamptz [not null]
  updated_at timestamptz

  indexes {
    submission_id
  }
}

// Relationships & Foreign Keys
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: classrooms.owner_id > users.id [delete: restrict]
Ref: classroom_members.classroom_id > classrooms.id [delete: cascade]
Ref: classroom_members.user_id > users.id [delete: cascade]
Ref: channels.classroom_id > classrooms.id [delete: cascade]
Ref: channel_members.channel_id > channels.id [delete: cascade]
Ref: channel_members.user_id > users.id [delete: cascade]
Ref: messages.channel_id > channels.id [delete: cascade]
Ref: messages.sender_id > users.id [delete: restrict]
Ref: messages.thread_id > messages.id [delete: cascade]
Ref: message_reactions.message_id > messages.id [delete: cascade]
Ref: message_reactions.user_id > users.id [delete: cascade]
Ref: channel_pinned_messages.channel_id > channels.id [delete: cascade]
Ref: channel_pinned_messages.message_id > messages.id [delete: cascade]
Ref: channel_pinned_messages.pinned_by_id > users.id [delete: restrict]
Ref: notifications.user_id > users.id [delete: cascade]
Ref: task_items.classroom_id > classrooms.id [delete: cascade]
Ref: task_items.channel_id > channels.id [delete: cascade]
Ref: task_items.created_by_id > users.id [delete: restrict]
Ref: task_items.assignee_id > users.id [delete: set null]
Ref: task_items.source_message_id > messages.id [delete: set null]
Ref: class_schedules.classroom_id > classrooms.id [delete: cascade]
Ref: class_schedules.channel_id > channels.id [delete: set null]
Ref: class_schedules.created_by_id > users.id [delete: restrict]
Ref: study_reminders.user_id > users.id [delete: cascade]

// Curriculum Foreign Keys
Ref: classroom_topics.classroom_id > classrooms.id [delete: cascade]
Ref: classroom_items.topic_id > classroom_topics.id [delete: cascade]
Ref: classroom_items.classroom_id > classrooms.id [delete: cascade]
Ref: classroom_item_submissions.classroom_item_id > classroom_items.id [delete: cascade]
Ref: classroom_item_submissions.student_id > users.id [delete: cascade]
Ref: classroom_item_submissions.graded_by_id > users.id [delete: set null]
Ref: submission_attachment_items.submission_id > classroom_item_submissions.id [delete: cascade]
